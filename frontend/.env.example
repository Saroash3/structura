# MongoDB connection string (MongoDB Atlas free cluster or local mongod)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/structura
# Random secret for signing session tokens. Generate one with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string
# Optional: FastAPI backend URL (defaults to http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: the frontend proxies /api/backend/* to this URL (server-only), e.g. an ngrok tunnel to the backend
# BACKEND_URL=https://your-tunnel.ngrok-free.app
