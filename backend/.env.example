GEMINI_API_KEY=your-gemini-api-key-here
# Single model (used only when GEMINI_MODELS is not set)
GEMINI_MODEL=gemini-3.5-flash-lite
# Models to try in order when one is overloaded (503) or rate limited (429). Comma-separated.
# The first one is the primary model and is part of the response-cache key.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
